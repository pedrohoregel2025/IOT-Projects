byte pinReleA = D2;
byte pinReleB = D1;
bool valor = true;


//--------------------------------------------------------------------------------- SETUP

void setup() {

  Serial.begin(9600);//Iniciamos la comunicación serial
  pinMode(pinReleA, OUTPUT);
  pinMode(pinReleB, OUTPUT);


}

void loop() {

  digitalWrite(pinReleA, valor);    
  digitalWrite(pinReleB, valor);    
  delay(20000);
  valor = !valor;
}



